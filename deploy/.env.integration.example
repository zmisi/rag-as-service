# 复制为 deploy/.env.integration；不得提交真实密钥。
IMAGE_TAG=itest-YYYYMMDD-HHMM
HTTP_PORT=80

POSTGRES_USER=rag_app
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=lxzxai_rag
DATABASE_URL=postgresql+psycopg://rag_app:replace_with_url_encoded_password@db:5432/lxzxai_rag

SECRET_KEY=replace_with_openssl_rand_hex_32
PROXY_SHARED_SECRET=replace_with_another_random_secret
SESSION_COOKIE_NAME=pb_session
SESSION_COOKIE_DOMAIN=.lxzxai.com
SESSION_TTL_DAYS=14
# 必须与构建 Web 镜像时传给 scripts/build-integration-images.sh 的 APEX_HOST 一致。
APEX_HOST=lxzxai.com
COOKIE_SECURE=false

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_ENABLED=false
QWEN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
INGEST_WORKER_POLL_INTERVAL_SECONDS=2
INGEST_WORKER_BATCH_SIZE=5
INGEST_JOB_STUCK_AFTER_SECONDS=1800
